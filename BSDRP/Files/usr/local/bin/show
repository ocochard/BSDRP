# Uncomment for enable the debug mode:
# set -xv

# Strict script
set -eu

PAGER=${PAGER:-less}

# Get options passed by user
getoption () {
	if [ $# -ge 1 ]; then
		FIRST_OPTION="$1"
	else
		FIRST_OPTION=""
	fi
	if [ $# -ge 2 ]; then
		SECOND_OPTION="$2"
	else
		SECOND_OPTION=""
	fi
	if [ $# -ge 3 ]; then
		THIRD_OPTION="$3"
	else
		THIRD_OPTION=""
	fi

	case "$FIRST_OPTION" in
		authors|author)
			authors
			;;
		disk)
			disk
			;;
        help|h)
            usage
            ;;
		ifstat)
			ifstat
			;;
        license|lic)
            license
            ;;
		zone)
			zone
			;;
		mbuf)
			mbuf
			;;
        memory|mem)
            memory
            ;;
		mroute|mcast)
			mroute
			;;
		mtraffic)
			mtraffic
			;;
		packages|package)
			packages
			;;
        process|proc)
            process
            ;;
        route)
            route
            ;;
		tech-support)
			tech-support
			;;
		traffic)
			traffic
			;;
		version|ver)
            version
            ;;

		*)
			echo "Wrong or missing option"
			usage
			;;
	esac
}

# Display help
usage () {
	echo "BSD Router Project show tool"
	case "$SECOND_OPTION" in
        route)
			echo "Options for route:"
			echo " - ipv4/4 : Display only IPv4 routes"
			echo " - ipv6/6 : Display only IPv6 routes"
			;;
		process|proc)
			echo "Options for process:"
			echo " - cpu : CPU usage for each process"
			echo " - memory/mem : Memory usage of each process"
			echo " - int : Interrupt usage of each process"
			;;
		*)
# value $0 is the name of the called script
		echo "Usage: $0 option"
        echo "  - authors      : Display authors and contributors list"
		echo "  - disk         : Display disk name and active slice"
		echo "  - help/h [option]  : Display this help message. "
        echo "       If [option] given, display more detail about"
		echo "  - ifstat       : Display interface stats"
		echo "  - license/lic  : Display BSDRP license"
		echo "  - mbuf         : Display network memory management routine stats"
		echo "  - memory/mem   : Display general memory usage"
		echo "  - mroute/mcast : Display multicast group"
		echo "  - mtraffic     : Display multicast stats"
		echo "  - packages     : Display lists of installed packages"
		echo "  - process/proc : Display process information"
		echo "  - route        : Display routes"
		echo "  - traffic      : Display extensive IP traffic statistics"
		echo "  - tech-support : Display Lot's of information"
		echo "  - version/ver  : Display BSDRP version"
		echo "  - zone         : Display memory used by the kernel zone allocator"
			;;
	esac
	exit 0
}

# Display AUTHORS
authors () {
	$PAGER /root/AUTHORS
	exit 0
}

# Display disk name and active slice
disk () {
	. /etc/nanobsd.conf
	echo "Label to disk mapping:"
	glabel status | awk -v l="${NANO_DRIVE}" 'NR == 1 || index($1, l) == 1'
	# GPT: gpt/BSDRP1 on vtbd0p3, old MBR: ufs/BSDRPs1a on ada0s1a
	disk=$(glabel status | awk -v l="${NANO_DRIVE}" '$1 ~ "^" l "s?[12]a?$" \
		{ s=$3; sub(/[ps][1-4]a?$/, "", s); print s; exit }')
	if [ -z "${disk}" ]; then
		echo "Can't find the disk holding ${NANO_DRIVE}"
		exit 1
	fi
	echo "Partitions on disk ${disk}:"
	gpart show $disk
}

# Display LICENSE
license () {
    $PAGER /root/LICENSE
    exit 0
}

# Display mbuf usag
mbuf () {
	netstat -m
	exit 0
}

# Display interface stats
ifstat () {
	netstat -bdhi
	netstat -i -w1 -q 10
	exit 0
}

# Display memory used by the kernel zone allocator
zone () {
	vmstat -z
	exit 0
}


# Display traffic
traffic() {
	netstat -s
	exit 0
}

# Display packages
packages () {
	[ -f /var/db/pkg/local.sqlite ] && pkg info
	exit 0
}
# Display version
version () {
	VERSION=$(cat /etc/version)
	FREEBSD_VERSION=$(uname -srp)
	CONSOLE="vga"
	if [ -f /boot.config ]; then
		grep -q D /boot.config && CONSOLE="vga (with dual mode vga/serial enabled)"
		grep -q h /boot.config && CONSOLE="serial"
	fi
   	echo "BSD Router Project version: ${VERSION}"
	if ! echo ${FREEBSD_VERSION} | grep -q sparc64; then
		echo "   Console: $CONSOLE"
	fi
   	echo "Based on: ${FREEBSD_VERSION}"
	# Upstream sources this image was built from
	if [ -f /etc/version.build ]; then
		. /etc/version.build
		echo "   FreeBSD src: ${freebsd_hash} (${freebsd_branch}, n${freebsd_count})"
		echo "   Ports tree: ${ports_hash} (${ports_branch})"
		echo "   Built: ${build_date}"
	fi
	exit 0
}

# Display routes
route () {
	case "$SECOND_OPTION" in
		ipv4|4)
			netstat -rnW -f inet
			;;
		ipv6|6)
			netstat -rnW -f inet6
			;;
		*)
			netstat -rnW
			;;
	esac
	exit 0
}

# Display multicast routing
mroute () {
	netstat -gW
	exit 0
}

# Display multicast traffic stats
mtraffic () {
	ifmcstat
    netstat -gs
    exit 0
}

# Display memory usage information
# This function started as a shell re-writting of the perl script:
##  freebsd-memory -- List Total System Memory Usage
##  Copyright (c) 2003-2004 Ralf S. Engelschall <rse@engelschall.com>
## http://www.cyberciti.biz/files/scripts/freebsd-memory.pl.txt

# Print one line: label, operator, bytes, percentage base (empty: none), text
mem_line () {
	local pct=""
	[ -n "$4" ] && pct=$(printf "[%3d%%]" $(( $3 * 100 / $4 )))
	printf "%-13s %s %12d (%7dMB) %-6s %s\n" "$1" "$2" $3 $(( $3 / 1048576 )) \
		"${pct}" "$5"
}

memory () {
	local page mem_all mem_wire mem_active mem_inactive mem_laundry mem_free
	local mem_gap_vm mem_phys mem_gap_sys mem_hw mem_gap_hw mem_avail mem_used

	page=$(sysctl -n hw.pagesize)
	mem_all=$(( $(sysctl -n vm.stats.vm.v_page_count) * page ))
	mem_wire=$(( $(sysctl -n vm.stats.vm.v_wire_count) * page ))
	mem_active=$(( $(sysctl -n vm.stats.vm.v_active_count) * page ))
	mem_inactive=$(( $(sysctl -n vm.stats.vm.v_inactive_count) * page ))
	mem_laundry=$(( $(sysctl -n vm.stats.vm.v_laundry_count) * page ))
	mem_free=$(( $(sysctl -n vm.stats.vm.v_free_count) * page ))
	# Managed pages on none of the queues above
	mem_gap_vm=$(( mem_all - mem_wire - mem_active - mem_inactive \
		- mem_laundry - mem_free ))
	mem_phys=$(sysctl -n hw.physmem)
	mem_gap_sys=$(( mem_phys - mem_all ))
	mem_hw=$(sysctl -n hw.realmem)
	mem_gap_hw=$(( mem_hw - mem_phys ))
	# Laundry pages are dirty: they must be written to swap or to their file
	# before reuse, and anonymous ones never can be without swap. Only clean
	# inactive pages and free pages can be handed out.
	mem_avail=$(( mem_inactive + mem_free ))
	mem_used=$(( mem_phys - mem_avail ))

	echo "SYSTEM MEMORY INFORMATION:"
	mem_line mem_wire: " " $mem_wire $mem_all "Wired: cannot be paged out"
	mem_line mem_active: + $mem_active $mem_all "Active: recently referenced"
	mem_line mem_inactive: + $mem_inactive $mem_all "Inactive: not recently referenced"
	mem_line mem_laundry: + $mem_laundry $mem_all "Laundry: dirty, to be written out before reuse"
	mem_line mem_free: + $mem_free $mem_all "Free: available for allocation"
	mem_line mem_gap_vm: + $mem_gap_vm $mem_all "Managed but on no page queue"
	echo "_____________ _ ____________ _________ ______"
	mem_line mem_all: = $mem_all $mem_all "Managed by the VM system"
	mem_line mem_gap_sys: + $mem_gap_sys "" "Kernel image and early allocations (vm_page array)"
	echo "_____________ _ ____________ _________"
	mem_line mem_phys: = $mem_phys "" "Usable by the OS (hw.physmem)"
	mem_line mem_gap_hw: + $mem_gap_hw "" "Reserved by the firmware"
	echo "_____________ _ ____________ _________"
	mem_line mem_hw: = $mem_hw "" "Reported by the firmware (hw.realmem)"
	echo
	echo "SYSTEM MEMORY SUMMARY:"
	mem_line mem_used: " " $mem_used $mem_phys "Used (wired, active, laundry and kernel)"
	mem_line mem_avail: + $mem_avail $mem_phys "Available (inactive and free)"
	echo "_____________ _ ____________ _________ ______"
	mem_line mem_total: = $mem_phys $mem_phys "Usable by the OS (hw.physmem)"
	exit 0
}

# Display process information
process () {
	case "$SECOND_OPTION" in
	cpu)
		top -SCHPb
        ;;
    memory|mem)
		# Per-process resident and virtual memory, biggest first
		ps -axo pid,user,rss,vsz,comm -m
        ;;
	int)
		vmstat -i
		;;
     *)
		top -SCHPb
      	;;
     esac
     exit 0
}


# Display tech support
tech-support () {
	set +e
	echo "============ BSD Router Project Tech-support output ============"
	echo "== Current load statistics =="
	echo "==== Interrupt: vmstat -i ===="
	vmstat -i
	echo "==== CPU process: top -SCHPb ===="
	top -SCHPb
	echo "==== netisr: netstat -Q ===="
	netstat -Q
	echo "==== BPF state: netstat -B ===="
	netstat -B
	echo  "=== Zone allocator vmstat -z ===="
	vmstat -z | head -1 ; vmstat -z | grep -i mbuf
	echo "==== mbuf usage: netstat -m ===="
	netstat -m
	echo "==== netstat -nxaL ===="
	netstat -nxaL
	echo "==== show memory ===="
	show memory
	echo "==== Geom stats ===="
	gstat -b
	echo "==== netstat -s (show traffic) ===="
    netstat -s
	echo "==== Display the stacks of kernel threads ===="
	procstat -ak
	echo "== General system inventory =="
	echo "==== show version ===="
	show version
	echo "==== uname -a ===="
	uname -a
	echo "==== ifconfig -vm ===="
	ifconfig -vm
	echo "=== loaded module ==="
	kldstat -v
	echo "==== pciconf -lvbc ===="
	pciconf -lvbc
	echo "==== devinfo -rv ==="
	devinfo -rv
	echo "=== dmesg ==="
	cat /var/run/dmesg.boot
	echo "==== pkg info (show packages) ===="
	pkg info
}

###################
## Main function ##
###################

getoption $*
