frr10: zebra ignores the neighbor cache entries the FreeBSD kernel reports
on the routing socket.

When an IPv6 neighbor entry resolves, nd6.c sends RTM_ADD with
RTF_HOST | RTF_LLDATA (and RTM_DELETE when it expires). zebra's
rtm_read() skips RTF_WASCLONED but not RTF_LLDATA, so every IPv6
neighbor on a connected network becomes a "kernel" /128 route at
distance 0 ("K>* 2001:db8:113::10/128 is directly connected"), which
overrides static and BGP routes to the same host: in the rtbh lab, the
IPv6 blackhole trigger (a static /128 tagged 666) is never selected
("over-ridden by better route").
diff --git net/frr10/Makefile net/frr10/Makefile
index 65e16583a9f1..05dc1340398e 100644
--- net/frr10/Makefile
+++ net/frr10/Makefile
@@ -1,7 +1,7 @@
 PORTNAME=	frr
 DISTVERSIONPREFIX=	frr-
 DISTVERSION=	10.7.1
-PORTREVISION=	1
+PORTREVISION=	2
 CATEGORIES=	net
 .if defined(PYTHONTOOLS)
 PKGNAMESUFFIX=	10-pythontools
diff --git net/frr10/files/patch-zebra_kernel__socket.c net/frr10/files/patch-zebra_kernel__socket.c
new file mode 100644
index 000000000000..c467aa0951e9
--- /dev/null
+++ net/frr10/files/patch-zebra_kernel__socket.c
@@ -0,0 +1,17 @@
+--- zebra/kernel_socket.c.orig
++++ zebra/kernel_socket.c
+@@ -1033,6 +1033,14 @@ void rtm_read(struct rt_msghdr *rtm)
+ #endif
+ #ifdef RTF_WASCLONED /*freebsd*/
+ 	if (flags & RTF_WASCLONED)
++		return;
++#endif
++#ifdef RTF_LLDATA /*freebsd*/
++	/*
++	 * Neighbor cache entries (e.g. IPv6 ND), not routes: as kernel
++	 * routes they would override static or BGP host routes.
++	 */
++	if (flags & RTF_LLDATA)
+ 		return;
+ #endif
+ 
