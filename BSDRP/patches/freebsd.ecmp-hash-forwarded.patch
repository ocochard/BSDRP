diff --git sys/netinet/in_fib.c sys/netinet/in_fib.c
index d864bce0731..71ffb13ef4f 100644
--- sys/netinet/in_fib.c
+++ sys/netinet/in_fib.c
@@ -55,6 +55,7 @@
 #include <netinet/in.h>
 #include <netinet/in_var.h>
 #include <netinet/in_fib.h>
+#include <netinet/ip.h>
 
 #ifdef INET
 
@@ -97,6 +98,42 @@ fib4_calc_software_hash(struct in_addr src, struct in_addr dst,
 	  sizeof(data), (uint8_t *)&data));
 }
 
+/*
+ * Gives a packet about to be forwarded a flow hash when the receiving
+ * interface did not compute one (no RSS, or a single queue that reports its
+ * queue index), so a multipath route spreads flows over its nexthops
+ * instead of sending them all to the same one.
+ * The ports are only hashed on unfragmented packets, so the fragments of a
+ * datagram follow the same path.
+ */
+void
+fib4_hash_forwarded(struct mbuf *m)
+{
+	struct ip *ip;
+	uint16_t ports[2] = { 0, 0 };
+	uint32_t hashtype;
+	int hlen;
+
+	if (V_fib_hash_forward == 0 || M_HASHTYPE_ISHASH(m))
+		return;
+
+	ip = mtod(m, struct ip *);
+	hlen = ip->ip_hl << 2;
+	if ((ip->ip_p == IPPROTO_TCP || ip->ip_p == IPPROTO_UDP ||
+	    ip->ip_p == IPPROTO_SCTP) &&
+	    (ip->ip_off & htons(IP_MF | IP_OFFMASK)) == 0 &&
+	    m->m_pkthdr.len >= hlen + (int)sizeof(ports))
+		m_copydata(m, hlen, sizeof(ports), ports);
+
+	m->m_pkthdr.flowid = fib4_calc_software_hash(ip->ip_src, ip->ip_dst,
+	    ports[0], ports[1], ip->ip_p, &hashtype);
+	/*
+	 * Mark it as a hash, so later forwarding steps do not compute it
+	 * again and consumers such as lagg(4) can rely on it.
+	 */
+	M_HASHTYPE_SET(m, M_HASHTYPE_OPAQUE_HASH);
+}
