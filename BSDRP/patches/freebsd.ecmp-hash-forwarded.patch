diff --git sys/netinet6/in6_fib.c sys/netinet6/in6_fib.c
index 594a9dc0a24..8521b823674 100644
--- sys/netinet6/in6_fib.c
+++ sys/netinet6/in6_fib.c
@@ -103,6 +103,32 @@ fib6_calc_software_hash(const struct in6_addr *src, const struct in6_addr *dst,
 	  sizeof(data), (uint8_t *)&data));
 }
 
+/*
+ * IPv6 version of fib4_hash_forwarded().  The ports are only hashed when
+ * the transport header follows the IPv6 header: fragments carry a fragment
+ * header, so they all hash on the addresses only.
+ */
+void
+fib6_hash_forwarded(struct mbuf *m)
+{
+	struct ip6_hdr *ip6;
+	uint16_t ports[2] = { 0, 0 };
+	uint32_t hashtype;
+
+	if (V_fib_hash_forward == 0 || M_HASHTYPE_ISHASH(m))
+		return;
+
+	ip6 = mtod(m, struct ip6_hdr *);
+	if ((ip6->ip6_nxt == IPPROTO_TCP || ip6->ip6_nxt == IPPROTO_UDP ||
+	    ip6->ip6_nxt == IPPROTO_SCTP) &&
+	    m->m_pkthdr.len >= (int)(sizeof(*ip6) + sizeof(ports)))
+		m_copydata(m, sizeof(*ip6), sizeof(ports), ports);
+
+	m->m_pkthdr.flowid = fib6_calc_software_hash(&ip6->ip6_src,
+	    &ip6->ip6_dst, ports[0], ports[1], ip6->ip6_nxt, &hashtype);
+	M_HASHTYPE_SET(m, M_HASHTYPE_OPAQUE_HASH);
+}
+
