diff --git sys/netgraph/netflow/netflow.c sys/netgraph/netflow/netflow.c
index 3b3878dbcde..3193b678621 100644
--- sys/netgraph/netflow/netflow.c
+++ sys/netgraph/netflow/netflow.c
@@ -1085,6 +1085,40 @@ export_add(item_p item, struct flow_entry *fle)
 		return (0);	
 }
 
+/*
+ * Send the export datagrams that are not full yet: on a quiet node, a
+ * datagram could otherwise wait a long time for enough flows to fill it.
+ */
+static void
+export_flush(priv_p priv)
+{
+	struct netflow_v9_packet_opt *t;
+	fib_export_p fe;
+	item_p item;
+	int i;
+
+	for (i = 0; i < priv->maxfibs; i++) {
+		if ((fe = priv_to_fib(priv, i)) == NULL)
+			continue;
+
+		mtx_lock(&fe->export_mtx);
+		item = fe->exp.item;
+		fe->exp.item = NULL;
+		mtx_unlock(&fe->export_mtx);
+		if (item != NULL)
+			export_send(priv, fe, item, NG_NOFLAGS);
+
+		mtx_lock(&fe->export9_mtx);
+		item = fe->exp.item9;
+		t = fe->exp.item9_opt;
+		fe->exp.item9 = NULL;
+		fe->exp.item9_opt = NULL;
+		mtx_unlock(&fe->export9_mtx);
+		if (item != NULL)
+			export9_send(priv, fe, item, t, NG_NOFLAGS);
+	}
+}
+
 /* Periodic flow expiry run. */
 void
 ng_netflow_expire(void *arg)
@@ -1172,6 +1206,9 @@ ng_netflow_expire(void *arg)
 	}
 #endif
 
+	/* Send what expired since the previous run. */
+	export_flush(priv);
+
 	/* Schedule next expire. */
 	callout_reset(&priv->exp_callout, (1*hz), &ng_netflow_expire,
 	    (void *)priv);
