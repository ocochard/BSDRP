-@@ -27,6 +27,7 @@ SAVE_CONFIG=0
+@@ -27,6 +27,7 @@ ARGS=( "$@" )
  CONFIG_FILE=""
  PROGRAM="${0##*/}"
  ARGS=( "$@" )
@@ -8,10 +8,32 @@
  
  cmd() {
  	echo "[#] $*" >&3
-@@ -283,20 +284,28 @@ monitor_daemon() {
+@@ -131,14 +132,14 @@ del_routes() {
+ 
+ del_routes() {
+ 	local todelete=( ) destination gateway netif
+-	while read -r destination _ _ _ _ netif _; do
++	while read -r destination _ _ netif _; do
+ 		[[ $netif == "$INTERFACE" ]] && todelete+=( "$destination" )
+ 	done < <(netstat -nr -f inet)
+ 	for destination in "${todelete[@]}"; do
+ 		cmd route -q -n delete -inet "$destination" || true
+ 	done
+ 	todelete=( )
+-	while read -r destination gateway _ netif; do
++	while read -r destination gateway _ netif _; do
+ 		[[ $netif == "$INTERFACE" || ( $netif == lo* && $gateway == "$INTERFACE" ) ]] && todelete+=( "$destination" )
+ 	done < <(netstat -nr -f inet6)
+ 	for destination in "${todelete[@]}"; do
+@@ -283,21 +284,32 @@ monitor_daemon() {
+ monitor_daemon() {
  	echo "[+] Backgrounding route monitor" >&2
  	(make_temp
- 	trap 'del_routes; clean_temp; exit 0' INT TERM EXIT
+-	trap 'del_routes; clean_temp; exit 0' INT TERM EXIT
++	# Only clean up after the interface is gone: the monitor can also be
++	# killed while it is up (e.g. along with the session that started
++	# wg-quick), and its routes must then stay.
++	trap 'ifconfig "$INTERFACE" >/dev/null 2>&1 || del_routes; clean_temp; exit 0' INT TERM EXIT
 +	local event grep_for pid
 +	if [[ "$FREEBSD_MAJOR_VERSION" -lt 14 ]]; then
 +		grep_for="RTM_"
