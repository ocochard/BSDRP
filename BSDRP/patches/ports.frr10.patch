diff --git net/frr10/files/patch-zebra_kernel__socket.c net/frr10/files/patch-zebra_kernel__socket.c
new file mode 100644
index 000000000000..c467aa0951e9
--- /dev/null
+++ net/frr10/files/patch-zebra_kernel__socket.c
@@ -0,0 +1,17 @@
+--- zebra/kernel_socket.c.orig
++++ zebra/kernel_socket.c
+@@ -1033,6 +1033,14 @@ void rtm_read(struct rt_msghdr *rtm)
+ #endif
+ #ifdef RTF_WASCLONED /*freebsd*/
+ 	if (flags & RTF_WASCLONED)
++		return;
++#endif
++#ifdef RTF_LLDATA /*freebsd*/
++	/*
++	 * Neighbor cache entries (e.g. IPv6 ND), not routes: as kernel
++	 * routes they would override static or BGP host routes.
++	 */
++	if (flags & RTF_LLDATA)
+ 		return;
+ #endif
+ 
diff --git net/frr10/files/patch-bgpd_bgp__rpki.c net/frr10/files/patch-bgpd_bgp__rpki.c
new file mode 100644
--- /dev/null
+++ net/frr10/files/patch-bgpd_bgp__rpki.c
@@ -0,0 +1,28 @@
+--- bgpd/bgp_rpki.c.orig
++++ bgpd/bgp_rpki.c
+@@ -602,19 +602,16 @@
+ static void rpki_revalidate_prefix(struct event *event)
+ {
+ 	struct rpki_revalidate_prefix *rrp = EVENT_ARG(event);
+-	struct bgp_dest *match, *node;
++	struct route_node *match, *node;
++	struct bgp_dest *dest;
+ 
+ 	match = bgp_table_subtree_lookup(rrp->bgp->rib[rrp->afi][rrp->safi],
+ 					 &rrp->prefix);
+ 
+-	node = match;
+-
+-	while (node) {
+-		if (bgp_dest_has_bgp_path_info_data(node)) {
+-			revalidate_bgp_node(rrp->bgp, node, rrp->afi, rrp->safi);
+-		}
+-
+-		node = bgp_route_next_until(node, match);
++	for (node = match; node; node = route_next_until(node, match)) {
++		dest = bgp_dest_from_rnode(node);
++		if (dest && bgp_dest_has_bgp_path_info_data(dest))
++			revalidate_bgp_node(rrp->bgp, dest, rrp->afi, rrp->safi);
+ 	}
+ 
+ 	XFREE(MTYPE_BGP_RPKI_REVALIDATE, rrp);
diff --git net/frr10/files/patch-bgpd_bgp__table.c net/frr10/files/patch-bgpd_bgp__table.c
new file mode 100644
--- /dev/null
+++ net/frr10/files/patch-bgpd_bgp__table.c
@@ -0,0 +1,76 @@
+--- bgpd/bgp_table.c.orig
++++ bgpd/bgp_table.c
+@@ -242,52 +242,46 @@
+ 	}
+ }
+ 
+-struct bgp_dest *bgp_table_subtree_lookup(const struct bgp_table *table,
+-					  const struct prefix *p)
++struct route_node *bgp_table_subtree_lookup(const struct bgp_table *table,
++					    const struct prefix *p)
+ {
+-	struct bgp_dest *dest;
+-	struct bgp_dest *matched = NULL;
++	struct route_node *node;
++	struct route_node *matched = NULL;
+ 
+ 	/* Unique-mode case is special; no iteration or prefix search */
+-	if (route_table_is_unique_mode(table->route_table)) {
+-		dest = bgp_node_lookup(table, p);
+-		return dest;
+-	}
++	if (route_table_is_unique_mode(table->route_table))
++		return route_node_lookup(table->route_table, p);
+ 
+-	/* Search in LPM table */
+-	dest = bgp_dest_from_rnode(table->route_table->top);
+-	if (dest == NULL)
+-		return NULL;
+-
+-	while (dest) {
+-		const struct prefix *dest_p = bgp_dest_get_prefix(dest);
+-		struct route_node *node = dest->rn;
+-
+-		if (dest_p->prefixlen >= p->prefixlen) {
+-			if (!prefix_match(p, dest_p))
++	/*
++	 * Search in LPM table. Walk the route nodes, not the bgp_dests: the
++	 * internal nodes of the trie, such as its top node when it holds
++	 * several prefixes, have no bgp_dest.
++	 */
++	node = table->route_table->top;
++	while (node) {
++		if (node->p.prefixlen >= p->prefixlen) {
++			if (!prefix_match(p, &node->p))
+ 				return NULL;
+ 
+-			matched = dest;
++			matched = node;
+ 			break;
+ 		}
+ 
+-		if (!prefix_match(dest_p, p))
++		if (!prefix_match(&node->p, p))
+ 			return NULL;
+ 
+-		if (dest_p->prefixlen == p->prefixlen) {
+-			matched = dest;
++		if (node->p.prefixlen == p->prefixlen) {
++			matched = node;
+ 			break;
+ 		}
+ 
+-		dest = bgp_dest_from_rnode(
+-			node->link[prefix_bit(&p->u.prefix, dest_p->prefixlen)]);
++		node = node->link[prefix_bit(&p->u.prefix, node->p.prefixlen)];
+ 	}
+ 
+ 	if (!matched)
+ 		return NULL;
+ 
+-	bgp_dest_lock_node(matched);
+-	return matched;
++	return route_lock_node(matched);
+ }
+ 
+ printfrr_ext_autoreg_p("BD", printfrr_bd);
diff --git net/frr10/files/patch-bgpd_bgp__table.h net/frr10/files/patch-bgpd_bgp__table.h
