Give the multicast routing, IGMP, ip6_mloopback() and ng_ether call sites a
private, writable header again.

These callers write to a header they first unshare with:

	if (!M_WRITABLE(m) || m->m_len < len)
		m = m_pullup(m, len);

Since 671babc7949 ("mbuf: make m_pullup() an inline over most expected
case", D60688), m_pullup() returns the mbuf unchanged when the bytes are
already contiguous, so the header stays in the shared cluster. Use
m_copyup(), which always allocates a new mbuf for the header.

Observed in the BSDRP full lab:
- ip_mroute.c phyint_send(): forwarded IPv4 multicast fragments corrupted,
  ip_reass() rewrites the original header while the copy waits to be sent.
- ip6_mroute.c ip6_mdq(): the wrong-MIF upcall writes an mrt6msg over the
  original IPv6 header (version, traffic class, flow label); a local member
  receives traffic class 0x02 instead of 0xb8.

diff --git sys/netgraph/ng_ether.c sys/netgraph/ng_ether.c
index db56ec504cfe..1ec181402dce 100644
--- sys/netgraph/ng_ether.c
+++ sys/netgraph/ng_ether.c
@@ -694,8 +694,8 @@ ng_ether_rcv_lower(hook_p hook, item_p item)
 	/* Drop in the MAC address if desired */
 	if (priv->autoSrcAddr) {
 		/* Make the mbuf writable if it's not already */
-		if (!M_WRITABLE(m)
-		    && (m = m_pullup(m, sizeof(struct ether_header))) == NULL)
+		if (!M_WRITABLE(m) &&
+		    (m = m_copyup(m, sizeof(struct ether_header), 0)) == NULL)
 			return (ENOBUFS);
 
 		/* Overwrite source MAC address */
diff --git sys/netinet/igmp.c sys/netinet/igmp.c
index 5c6c46a4f4f2..1e9c2fb5432f 100644
--- sys/netinet/igmp.c
+++ sys/netinet/igmp.c
@@ -1509,7 +1509,7 @@ igmp_input(struct mbuf **mp, int *offp, int proto)
 	else
 		minlen += IGMP_MINLEN;
 	if ((!M_WRITABLE(m) || m->m_len < minlen) &&
-	    (m = m_pullup(m, minlen)) == NULL) {
+	    (m = m_copyup(m, minlen, 0)) == NULL) {
 		IGMPSTAT_INC(igps_rcv_tooshort);
 		return (IPPROTO_DONE);
 	}
@@ -1601,7 +1601,7 @@ igmp_input(struct mbuf **mp, int *offp, int proto)
 			   sizeof(struct in_addr) * nsrc;
 			if ((!M_WRITABLE(m) ||
 			     m->m_len < igmpv3len) &&
-			    (m = m_pullup(m, igmpv3len)) == NULL) {
+			    (m = m_copyup(m, igmpv3len, 0)) == NULL) {
 				IGMPSTAT_INC(igps_rcv_tooshort);
 				return (IPPROTO_DONE);
 			}
diff --git sys/netinet/ip_mroute.c sys/netinet/ip_mroute.c
index 0ab120ae08e0..0e64bab1a531 100644
--- sys/netinet/ip_mroute.c
+++ sys/netinet/ip_mroute.c
@@ -1460,7 +1460,7 @@ X_ip_mforward(struct ip *ip, struct ifnet *ifp, struct mbuf *m,
 
 	mb0 = m_copypacket(m, M_NOWAIT);
 	if (mb0 && (!M_WRITABLE(mb0) || mb0->m_len < hlen))
-		mb0 = m_pullup(mb0, hlen);
+		mb0 = m_copyup(mb0, hlen, 0);
 	if (mb0 == NULL) {
 		free(rte, M_MRTABLE);
 		MRW_WUNLOCK();
@@ -1688,7 +1688,7 @@ ip_mdq(struct mfctable *mfct, struct mbuf *m, struct ifnet *ifp, struct mfc *rt,
 				struct mbuf *mm = m_copym(m, 0, hlen, M_NOWAIT);
 
 				if (mm && (!M_WRITABLE(mm) || mm->m_len < hlen))
-					mm = m_pullup(mm, hlen);
+					mm = m_copyup(mm, hlen, 0);
 				if (mm == NULL)
 					return ENOBUFS;
 
@@ -1832,7 +1832,7 @@ phyint_send(struct ip *ip, struct vif *vifp, struct mbuf *m)
 	 */
 	mb_copy = m_copypacket(m, M_NOWAIT);
 	if (mb_copy && (!M_WRITABLE(mb_copy) || mb_copy->m_len < hlen))
-		mb_copy = m_pullup(mb_copy, hlen);
+		mb_copy = m_copyup(mb_copy, hlen, 0);
 	if (mb_copy == NULL)
 		return;
 
